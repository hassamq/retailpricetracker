# Primary live multi-retailer prices (Google Shopping)
# 64-char hex from https://serpapi.com/manage-api-key
SERPAPI_KEY=

# Optional fill-ins when SerpApi is thin
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-flash-lite-latest

# Optional — free key from https://developer.bestbuy.com/
BESTBUY_API_KEY=

# false = SerpApi + retailer pages + Gemini grounding first
USE_MOCK_DATA=false
